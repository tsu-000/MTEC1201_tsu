const cS = 600;
 let rectW = 100;
  let rectH = 50;
  let rectY = 0;
  let rectX = cS/2 - rectW/2;


function setup() {
  createCanvas(cS, cS * 1.5);

  rectW =200;
  rectH = 50;
  rectY = 0;
  rectX = cS/2 - rectW/2 
}

function draw() {
  background (240,240,255);
  
  rect(rectX, rectY, rectW, rectH);
  rect = frameCount % 200; 
  rectX = cS/2 - rectW/2;

  print ("frameCount", frameCount);
}
